msgstr "广告追踪"
msgid "These identifiers apply only to this landing page."
msgstr "这些标识符仅适用于此着陆页。"
msgid "Enable Meta Pixel"
msgstr "启用 Meta Pixel"
msgid "Meta Pixel ID"
msgstr "Meta Pixel ID"
msgid "Facebook and Instagram advertising"
msgstr "Facebook 和 Instagram 广告"
msgid "The numeric ID shown in Meta Events Manager."
msgstr "Meta 事件管理工具中显示的数字 ID。"
msgid "Enable Google Ads tracking"
msgstr "启用 Google Ads 追踪"
msgid "Google Ads ID"
msgstr "Google Ads ID"
msgid "Default conversion label"
msgstr "默认转化标签"
msgid "Google advertising conversions"
msgstr "Google 广告转化"
msgid "Usually starts with AW-."
msgstr "通常以 AW- 开头。"
msgid "Optional default label for Google Ads conversion events."
msgstr "Google Ads 转化事件的可选默认标签。"
msgid "Enable OpenAI / ChatGPT Ads Pixel"
msgstr "启用 OpenAI / ChatGPT Ads Pixel"
msgid "OpenAI Pixel ID"
msgstr "OpenAI Pixel ID"
msgid "ChatGPT advertising conversions"
msgstr "ChatGPT 广告转化"
msgid "Create this in the Conversions area of OpenAI Ads Manager."
msgstr "请在 OpenAI Ads Manager 的转化区域中创建。"
msgid "Visitor consent"
msgstr "访客同意"
msgid "Wait for visitor consent before browser tracking"
msgstr "开始浏览器追踪前等待访客同意"
msgid "Keep this enabled when your visitors must consent before advertising measurement begins."
msgstr "当访客必须先同意才能开始广告衡量时，请保持启用。"
msgid "Save tracking settings"
msgstr "保存追踪设置"
msgid "Open advanced admin"
msgstr "打开高级管理"
msgid "Conversions API key configured"
msgstr "Conversions API 密钥已配置"
msgid "Conversions API key not configured"
msgstr "Conversions API 密钥未配置"
msgid "Server key configured"
msgstr "服务器密钥已配置"
msgid "Browser tracking only"
msgstr "仅浏览器追踪"
msgid "Browser pixel"
msgstr "浏览器 Pixel"
msgid "Tracking runs on the published page after consent and is disabled in previews."
msgstr "追踪会在访客同意后于已发布页面运行，并在预览中停用。"

msgid "Enter a hostname only, without https://, a path, or a port."
msgstr "只请输入主机名，不要包含 https://、路径或端口。"

msgid "Enter a valid domain such as promo.example.com."
msgstr "请输入有效域名，例如 promo.example.com。"

msgid "Enter the domain you want visitors to use. We will give you the CNAME record to add at Exabytes or another DNS provider."
msgstr "输入您希望访客使用的域名。系统会提供需要在 Exabytes 或其他 DNS 服务商添加的 CNAME 记录。"

msgid "Example: promo.yourdomain.com — do not include https:// or a page path."
msgstr "例如：promo.yourdomain.com — 不要包含 https:// 或页面路径。"

msgid "Continue to DNS setup"
msgstr "继续设置 DNS"

msgid "DNS setup required"
msgstr "需要设置 DNS"

msgid "Connected"
msgstr "已连接"

msgid "Pending"
msgstr "等待中"

msgid "Use your own branded URL for this page."
msgstr "为此页面使用您自己的品牌网址。"

msgid "Domain setup"
msgstr "域名设置"

msgid "Connect your domain"
msgstr "连接您的域名"

msgid "Pending DNS"
msgstr "等待 DNS"

msgid "Your domain is connected"
msgstr "您的域名已连接"

msgid "HTTPS is issued automatically. Your published landing page is available at:"
msgstr "HTTPS 证书会自动签发。已发布的落地页网址是："

msgid "EXABYTES DNS SETUP"
msgstr "EXABYTES DNS 设置"

msgid "Add this CNAME record"
msgstr "添加此 CNAME 记录"

msgid "Open your domain's DNS management page at Exabytes, add the record below, and save it."
msgstr "在 Exabytes 打开域名的 DNS 管理页面，添加以下记录并保存。"

msgid "Type"
msgstr "类型"

msgid "Name / Host"
msgstr "名称 / 主机"

msgid "Value / Points to"
msgstr "值 / 指向"

msgid "Copy value"
msgstr "复制值"

msgid "Exabytes may shorten the Name field."
msgstr "Exabytes 可能会缩短名称字段。"

msgid "If your domain is example.com and you are connecting promo.example.com, enter promo as the Name. Keep DNS proxying disabled while connecting."
msgstr "如果您的域名是 example.com，并要连接 promo.example.com，请在名称中输入 promo。连接期间请关闭 DNS 代理。"

msgid "Verify connection"
msgstr "验证连接"

msgid "DNS updates can take a few minutes or, occasionally, up to 24 hours."
msgstr "DNS 更新通常需要几分钟，偶尔可能需要长达 24 小时。"

msgid "Cannot use a CNAME? Verify ownership with TXT"
msgstr "无法使用 CNAME？通过 TXT 验证所有权"

msgid "Some root domains require an ALIAS/ANAME record. Point it to the same value, then add this TXT record for verification:"
msgstr "部分根域名需要 ALIAS/ANAME 记录。请将其指向相同的值，然后添加此 TXT 记录进行验证："

msgid "URL path"
msgstr "网址路径"

msgid "Landing page"
msgstr "落地页"

msgid "Use lowercase letters, numbers, and hyphens, such as thankyou."
msgstr "请使用小写字母、数字和连字符，例如 thankyou。"

msgid "This path is reserved by the application. Choose another path."
msgstr "此路径由应用程序保留，请选择其他路径。"

msgid "PUBLISHED ROUTES"
msgstr "已发布路线"

msgid "Pages on this domain"
msgstr "此域名上的页面"

msgid "Give each published landing page its own path on the same domain."
msgstr "在同一个域名下，为每个已发布的落地页设置独立路径。"

msgid "Root page"
msgstr "根页面"

msgid "Remove route"
msgstr "移除路线"

msgid "Add page route"
msgstr "添加页面路线"
